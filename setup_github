#!/bin/bash

set -euo pipefail

SSH_KEY_PATH="$HOME/.ssh/id_ed25519"

if [ ! -e "$SSH_KEY_PATH.pub" ]; then
  ssh-keygen -t ed25519 -N "" -f "$SSH_KEY_PATH"
fi

GITHUB_PUBKEY=$(cat "$SSH_KEY_PATH.pub")

read -rs -p 'GitHub Personal Access Token: ' GITHUB_PAT
echo

AUTH_HEADER="Authorization: token $GITHUB_PAT"

existing_keys=$(curl -fsS -H "Content-Type: application/json" -H "$AUTH_HEADER" "https://api.github.com/user/keys")

if echo "$existing_keys" | grep -Fq "$GITHUB_PUBKEY"; then
  echo "Public key already registered with GitHub."
  exit 0
fi

curl -XPOST -fsS \
  -H "Content-Type: application/json" \
  -H "$AUTH_HEADER" \
  -d "{\"title\": \"$USER@$HOSTNAME\", \"key\": \"$GITHUB_PUBKEY\"}" \
  "https://api.github.com/user/keys"

echo
echo "Public key registered successfully."
